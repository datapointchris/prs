diff --git a/cache/counter.go b/cache/metrics.go
similarity index 31%
rename from cache/counter.go
rename to cache/metrics.go
index 5d1c2e3..8f7a6b5 100644
--- a/cache/counter.go
+++ b/cache/metrics.go
@@ -1,6 +1,17 @@
 package cache

 import "sync/atomic"

-// counter counts one thing the cache does.
-type counter = atomic.Int64
+// Stats counts what the cache does, for its metrics endpoint.
+type Stats struct {
+	hits   atomic.Int64
+	misses atomic.Int64
+}
+// HitRate is the share of reads the cache answered, and 0 before any read.
+func (s *Stats) HitRate() float64 {
+	hits, misses := s.hits.Load(), s.misses.Load()
+	if hits+misses == 0 {
+		return 0
+	}
+	return float64(hits) / float64(hits+misses)
+}
